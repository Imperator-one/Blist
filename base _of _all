    <script>
        // ===== ДАННЫЕ =====
        const chatHistory = {
            "Александр Петров": [
                { type: "incoming", isHTML: false, text: "Привет! Как продвигается разработка мессенджера?", time: "17:30" },
                { type: "outgoing", isHTML: false, text: "Привет! Почти закончила базовую структуру сайдбара и навигации.", time: "17:35" },
                { type: "incoming", isHTML: false, text: "Привет! Проект Blist готов к запуску?", time: "17:45" }
            ],
            "Дизайн-команда": [
                { type: "incoming", isHTML: false, text: "Всем привет! Мы обновили UI-кит проекта.", time: "14:50" },
                { type: "outgoing", isHTML: false, text: "Отлично, сейчас посмотрю.", time: "14:55" },
                { type: "incoming", isHTML: false, text: "Выслали новые макеты для страницы профиля", time: "15:12" }
            ],
            "Иван Иванов": [
                { type: "incoming", isHTML: false, text: "Привет, есть минутка обсудить код?", time: "Вчера" },
                { type: "outgoing", isHTML: false, text: "Да, давай созвонимся.", time: "Вчера" },
                { type: "incoming", isHTML: false, text: "Договорились, созвонимся позже.", time: "Вчера" }
            ],
            "Мария Смирнова": [
                { type: "incoming", isHTML: false, text: "Привет! Как дела?", time: "12:20" },
                { type: "outgoing", isHTML: false, text: "Привет! Всё отлично, работаю над Blist", time: "12:25" },
                { type: "incoming", isHTML: false, text: "Спасибо за помощь с проектом!", time: "12:30" }
            ]
        };

        // ===== СОСТОЯНИЕ =====
        let currentChatId = null;
        let typingTimer = null;
        let currentTheme = localStorage.getItem('blist_theme') || 'dark';
        let profileData = JSON.parse(localStorage.getItem('blist_profile')) || {
            name: 'Разработчик Blist',
            username: '@blist_dev',
            status: 'Работаю над проектом',
            avatar: null
        };

        // ===== DOM-ЭЛЕМЕНТЫ =====
        const navButtons = document.querySelectorAll('.nav-item');
        const appScreens = document.querySelectorAll('.app-screen');
        const searchInput = document.querySelector('.search-input');
        const searchClearBtn = document.getElementById('searchClearBtn');
        const chatsScreen = document.getElementById('chatsScreen');
        const searchResultsScreen = document.createElement('div');
        searchResultsScreen.id = 'searchResultsScreen';
        searchResultsScreen.className = 'app-screen';
        chatsScreen.parentNode.appendChild(searchResultsScreen);

        // ===== ФУНКЦИИ =====
        function getCurrentTime() {
            const now = new Date();
            return now.getHours().toString().padStart(2, '0') + ':' + now.getMinutes().toString().padStart(2, '0');
        }

        function renderMessages(chatId) {
            const messagesArea = document.getElementById('chatMessages');
            messagesArea.innerHTML = '';
            if (chatHistory[chatId]) {
                chatHistory[chatId].forEach(msg => {
                    const msgBubble = document.createElement('div');
                    msgBubble.className = `message-bubble ${msg.type}`;
                    if (msg.isHTML) {
                        msgBubble.innerHTML = msg.text;
                    } else {
                        msgBubble.innerText = msg.text;
                    }
                    if (msg.time) {
                        const timeSpan = document.createElement('div');
                        timeSpan.className = 'message-time';
                        timeSpan.innerText = msg.time;
                        msgBubble.appendChild(timeSpan);
                    }
                    messagesArea.appendChild(msgBubble);
                });
            }
            messagesArea.scrollTop = messagesArea.scrollHeight;
        }

        function openChat(chatId, avatar, color) {
            const placeholder = document.getElementById('chatPlaceholder');
            const mainWindow = document.getElementById('chatMainWindow');
            const activeAvatar = document.getElementById('activeChatAvatar');
            const activeName = document.getElementById('activeChatName');

            currentChatId = chatId;
            
            document.querySelectorAll('.chat-item[data-username], .contact-item[data-username]').forEach(i => {
                i.classList.remove('active');
                if (i.getAttribute('data-username') === chatId) {
                    i.classList.add('active');
                }
            });
            
            placeholder.style.display = 'none';
            mainWindow.classList.add('active');
            activeName.innerText = chatId;
            activeAvatar.innerText = avatar || chatId.charAt(0);
            activeAvatar.style.color = color || '#60a5fa';
            
            document.querySelectorAll(`.chat-item[data-username="${chatId}"] .chat-badge`).forEach(b => b.remove());
            
            renderMessages(chatId);
            document.getElementById('emojiPicker').classList.remove('show');
        }

        function sendOutgoingMessage(isHTML, content, sidebarText, fileData = null) {
            if (!currentChatId) return;
            if (!chatHistory[currentChatId]) {
                chatHistory[currentChatId] = [];
            }
            
            const time = getCurrentTime();
            chatHistory[currentChatId].push({ 
                type: "outgoing", 
                isHTML: isHTML, 
                text: content,
                time: time,
                fileData: fileData
            });
            
            document.querySelectorAll(`.chat-item[data-username="${currentChatId}"]`).forEach(item => {
                const lastMsg = item.querySelector('.chat-last-message');
                if (lastMsg) lastMsg.innerText = sidebarText;
                const timeEl = item.querySelector('.chat-time');
                if (timeEl) timeEl.innerText = time;
            });
            
            renderMessages(currentChatId);
            saveChatHistory();
        }

        function sendMessage() {
            const text = document.getElementById('messageInputField').value.trim();
            if (text !== '' && currentChatId) {
                sendOutgoingMessage(false, text, text);
                document.getElementById('messageInputField').value = '';
                document.getElementById('messageInputField').style.height = 'auto';
            }
        }

        function handleSearch(query) {
            const cleanQuery = query.trim().toLowerCase();
            const originalChats = chatsScreen.querySelectorAll('.chat-item');
            
            const isChatsActive = document.querySelector('.nav-item[data-screen="chatsScreen"]').classList.contains('active');
            if (!isChatsActive) {
                searchClearBtn.style.display = 'none';
                searchResultsScreen.classList.remove('screen-active');
                return;
            }
            
            if (cleanQuery === '') {
                searchClearBtn.style.display = 'none';
                searchResultsScreen.classList.remove('screen-active');
                chatsScreen.classList.add('screen-active');
                document.querySelectorAll('#chatsScreen .chat-item[data-username]').forEach(i => {
                    if (i.getAttribute('data-username') === currentChatId) i.classList.add('active');
                    else i.classList.remove('active');
                });
                return;
            }
            
            searchClearBtn.style.display = 'flex';
            chatsScreen.classList.remove('screen-active');
            searchResultsScreen.classList.add('screen-active');
            searchResultsScreen.innerHTML = '';
            
            let foundByNames = [];
            let foundByMessages = [];
            
            originalChats.forEach(chat => {
                const name = chat.getAttribute('data-username').toLowerCase();
                const lastMsg = chat.querySelector('.chat-last-message').innerText.toLowerCase();
                const chatClone = chat.cloneNode(true);
                
                if (name.includes(cleanQuery)) {
                    const nameEl = chatClone.querySelector('.chat-name');
                    nameEl.innerHTML = highlightText(nameEl.innerText, cleanQuery);
                    foundByNames.push(chatClone);
                }
                
                if (lastMsg.includes(cleanQuery)) {
                    const msgEl = chatClone.querySelector('.chat-last-message');
                    msgEl.innerHTML = highlightText(msgEl.innerText, cleanQuery);
                    foundByMessages.push(chatClone);
                }
            });
            
            if (foundByNames.length === 0 && foundByMessages.length === 0) {
                searchResultsScreen.innerHTML = '<div class="no-results">Ничего не найдено 🔍</div>';
                return;
            }
            
            if (foundByNames.length > 0) {
                const nameDivider = document.createElement('div');
                nameDivider.className = 'search-divider';
                nameDivider.innerText = 'По названию чата';
                searchResultsScreen.appendChild(nameDivider);
                foundByNames.forEach(item => searchResultsScreen.appendChild(item));
            }
            
            if (foundByMessages.length > 0) {
                const msgDivider = document.createElement('div');
                msgDivider.className = 'search-divider';
                msgDivider.innerText = 'По тексту сообщений';
                msgDivider.style.marginTop = '10px';
                searchResultsScreen.appendChild(msgDivider);
                foundByMessages.forEach(item => searchResultsScreen.appendChild(item));
            }
        }

        function highlightText(text, query) {
            const regex = new RegExp(`(${query})`, 'gi');
            return text.replace(regex, '<mark>$1</mark>');
        }

        function saveChatHistory() {
            try {
                localStorage.setItem('blist_chat_history', JSON.stringify(chatHistory));
            } catch(e) {}
        }

        function loadChatHistory() {
            try {
                const saved = localStorage.getItem('blist_chat_history');
                if (saved) {
                    const parsed = JSON.parse(saved);
                    Object.keys(parsed).forEach(key => {
                        if (chatHistory[key]) {
                            chatHistory[key] = parsed[key];
                        }
                    });
                }
            } catch(e) {}
        }

        function showTyping() {
            const indicator = document.getElementById('typingIndicator');
            indicator.classList.add('show');
            clearTimeout(typingTimer);
            typingTimer = setTimeout(() => {
                indicator.classList.remove('show');
            }, 2000);
        }

        function closeModal(id) {
            document.getElementById(id).classList.remove('show');
        }

        // ===== ПРОФИЛЬ =====
        function loadProfile() {
            document.getElementById('profileNameDisplay').textContent = profileData.name;
            document.getElementById('profileUsernameDisplay').textContent = profileData.username;
            document.getElementById('profileStatus').textContent = profileData.status;
            document.getElementById('currentStatusDisplay').textContent = profileData.status;
            
            const avatar = document.getElementById('profileAvatar');
            if (profileData.avatar) {
                avatar.style.backgroundImage = `url(${profileData.avatar})`;
                avatar.style.backgroundSize = 'cover';
                avatar.style.backgroundPosition = 'center';
                avatar.textContent = '';
            } else {
                avatar.style.backgroundImage = '';
                avatar.textContent = profileData.name.charAt(0).toUpperCase();
            }
        }

        function saveProfile() {
            const name = document.getElementById('editNameInput').value.trim();
            const username = document.getElementById('editUsernameInput').value.trim();
            const status = document.getElementById('editStatusInput').value.trim();
            
            if (name) profileData.name = name;
            if (username) profileData.username = username;
            if (status) profileData.status = status;
            
            localStorage.setItem('blist_profile', JSON.stringify(profileData));
            loadProfile();
            closeModal('profileEditModal');
            
            document.getElementById('currentStatusDisplay').textContent = profileData.status;
        }

        // Аватар
        document.getElementById('editAvatarInput').addEventListener('change', function(e) {
            if (this.files && this.files[0]) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    profileData.avatar = event.target.result;
                    localStorage.setItem('blist_profile', JSON.stringify(profileData));
                    document.getElementById('editAvatarPreview').style.backgroundImage = `url(${event.target.result})`;
                    document.getElementById('editAvatarPreview').style.backgroundSize = 'cover';
                    document.getElementById('editAvatarPreview').style.backgroundPosition = 'center';
                    document.getElementById('editAvatarPreview').textContent = '';
                    loadProfile();
                };
                reader.readAsDataURL(this.files[0]);
            }
        });

        document.getElementById('avatarInput').addEventListener('change', function(e) {
            if (this.files && this.files[0]) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    profileData.avatar = event.target.result;
                    localStorage.setItem('blist_profile', JSON.stringify(profileData));
                    loadProfile();
                };
                reader.readAsDataURL(this.files[0]);
            }
        });

        // ===== ТЕМЫ =====
        function applyTheme(theme) {
            const themes = {
                dark: { bg: '#0b0f19', sidebar: '#111827', card: '#1f2937', text: '#f0f4f8', border: '#1f2937', input: '#0b0f19' },
                light: { bg: '#f3f4f6', sidebar: '#ffffff', card: '#e5e7eb', text: '#111827', border: '#d1d5db', input: '#ffffff' },
                blue: { bg: '#0f172a', sidebar: '#1e293b', card: '#334155', text: '#f0f4f8', border: '#1e293b', input: '#0f172a' },
                green: { bg: '#0f1a0f', sidebar: '#1a2a1a', card: '#2a3a2a', text: '#f0f4f8', border: '#1a2a1a', input: '#0f1a0f' }
            };
            
            const t = themes[theme] || themes.dark;
            
            document.body.style.backgroundColor = t.bg;
            document.body.style.color = t.text;
            document.querySelector('.messenger-container').style.background = t.sidebar;
            document.querySelector('.sidebar').style.background = t.sidebar;
            document.querySelectorAll('.app-screen').forEach(el => el.style.background = t.sidebar);
            document.querySelectorAll('.settings-item, .chat-view-header, .chat-view-footer').forEach(el => {
                el.style.background = t.card;
                el.style.borderColor = t.border;
            });
            document.querySelectorAll('.chat-messages-area, .chat-view').forEach(el => el.style.background = t.bg);
            document.querySelectorAll('.message-input, .search-input').forEach(el => {
                el.style.background = t.input;
                el.style.color = t.text;
            });
        }

        function selectTheme(theme) {
            currentTheme = theme;
            localStorage.setItem('blist_theme', theme);
            
            document.querySelectorAll('.modal-option[data-theme]').forEach(opt => {
                opt.classList.remove('active');
                if (opt.dataset.theme === theme) opt.classList.add('active');
            });
            
            document.getElementById('currentThemeDisplay').textContent = 
                theme === 'dark' ? 'Тёмная' : 
                theme === 'light' ? 'Светлая' : 
                theme === 'blue' ? 'Синяя' : 'Зелёная';
            
            applyTheme(theme);
            closeModal('themeModal');
        }

        // ===== СТАТУС =====
        function setStatus(status) {
            profileData.status = status;
            localStorage.setItem('blist_profile', JSON.stringify(profileData));
            loadProfile();
            closeModal('statusModal');
        }

        // ===== ФАЙЛЫ =====
        function formatFileSize(bytes) {
            if (bytes < 1024) return bytes + ' B';
            if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
            return (bytes / 1048576).toFixed(1) + ' MB';
        }

        function downloadFile(dataUrl, filename) {
            const link = document.createElement('a');
            link.href = dataUrl;
            link.download = filename;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        // ===== ПРОСМОТР КАРТИНОК =====
        document.addEventListener('click', function(e) {
            const img = e.target.closest('.message-media');
            if (img) {
                const overlay = document.createElement('div');
                overlay.className = 'image-overlay';
                overlay.innerHTML = `
                    <button class="close-btn">✕</button>
                    <img src="${img.src}" alt="Просмотр">
                `;
                document.body.appendChild(overlay);
                
                overlay.addEventListener('click', function(e) {
                    if (e.target === this || e.target.classList.contains('close-btn')) {
                        this.remove();
                    }
                });
                
                document.addEventListener('keydown', function closeOnEsc(e) {
                    if (e.key === 'Escape') {
                        overlay.remove();
                        document.removeEventListener('keydown', closeOnEsc);
                    }
                });
            }
        });

        // ===== ОЧИСТКА ИСТОРИИ =====
        function clearHistory() {
            Object.keys(chatHistory).forEach(key => {
                chatHistory[key] = [];
            });
            localStorage.removeItem('blist_chat_history');
            
            document.querySelectorAll('.chat-last-message').forEach(el => {
                el.textContent = 'Нет сообщений';
            });
            document.querySelectorAll('.chat-badge').forEach(el => el.remove());
            
            if (currentChatId) {
                renderMessages(currentChatId);
            }
            
            closeModal('confirmModal');
        }

        // ===== ИНИЦИАЛИЗАЦИЯ =====
        loadChatHistory();
        loadProfile();
        applyTheme(currentTheme);

        // Навигация
        navButtons.forEach(button => {
            button.addEventListener('click', () => {
                document.querySelector('.nav-item.active')?.classList.remove('active');
                button.classList.add('active');
                appScreens.forEach(screen => screen.classList.remove('screen-active'));
                const targetScreenId = button.getAttribute('data-screen');
                document.getElementById(targetScreenId).classList.add('screen-active');
                searchInput.value = '';
                handleSearch('');
            });
        });

        // Клик по чатам и контактам
        document.querySelector('.sidebar-content').addEventListener('click', function(e) {
            const chatItem = e.target.closest('.chat-item[data-username]');
            const contactItem = e.target.closest('.contact-item[data-username]');
            let target = chatItem || contactItem;
            
            if (target) {
                const chatId = target.getAttribute('data-username');
                const avatar = target.getAttribute('data-avatar');
                const color = target.getAttribute('data-color');
                
                if (contactItem && !chatHistory[chatId]) {
                    chatHistory[chatId] = [
                        { type: "incoming", isHTML: false, text: "Привет! Рад(а) познакомиться!", time: getCurrentTime() }
                    ];
                    const newChat = document.createElement('div');
                    newChat.className = 'chat-item';
                    newChat.setAttribute('data-username', chatId);
                    newChat.setAttribute('data-avatar', avatar);
                    newChat.setAttribute('data-color', color);
                    newChat.innerHTML = `
                        <div class="chat-avatar" style="color: ${color};">${avatar}</div>
                        <div class="chat-info">
                            <div class="chat-header"><span class="chat-name">${chatId}</span><span class="chat-time">${getCurrentTime()}</span></div>
                            <div class="chat-message-row"><span class="chat-last-message">Привет! Рад(а) познакомиться!</span></div>
                        </div>
                    `;
                    document.getElementById('chatsScreen').appendChild(newChat);
                }
                
                openChat(chatId, avatar, color);
            }
        });

        // Поиск
        searchInput.addEventListener('input', (e) => handleSearch(e.target.value));
        searchInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') handleSearch(e.target.value);
        });
        searchClearBtn.addEventListener('click', () => {
            searchInput.value = '';
            handleSearch('');
            searchInput.focus();
        });

        // Отправка сообщений
        document.getElementById('sendMessageBtn').addEventListener('click', sendMessage);
        document.getElementById('messageInputField').addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            }
        });

        // Эмодзи
        document.getElementById('emojiToggleBtn').addEventListener('click', (e) => {
            e.stopPropagation();
            document.getElementById('emojiPicker').classList.toggle('show');
        });
        document.querySelectorAll('.emoji-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const input = document.getElementById('messageInputField');
                input.value += btn.innerText;
                input.focus();
            });
        });
        document.addEventListener('click', () => {
            document.getElementById('emojiPicker').classList.remove('show');
        });
        document.getElementById('emojiPicker').addEventListener('click', (e) => e.stopPropagation());

        // ===== ФАЙЛЫ =====
        document.getElementById('attachFileBtn').addEventListener('click', () => {
            document.getElementById('fileAttachInput').click();
        });

        document.getElementById('fileAttachInput').addEventListener('change', function(e) {
            if (this.files.length > 0) {
                Array.from(this.files).forEach(file => {
                    const reader = new FileReader();
                    reader.onload = function(event) {
                        const fileData = event.target.result;
                        const size = formatFileSize(file.size);
                        
                        if (file.type.startsWith('image/')) {
                            sendOutgoingMessage(true, 
                                `<img src="${fileData}" class="message-media" alt="${file.name}">`,
                                `📷 ${file.name}`
                            );
                        } else {
                            const fileHtml = `
                                <div class="message-file-block">
                                    <span class="file-icon">📄</span>
                                    <div class="file-meta">
                                        <span class="file-name">${file.name}</span>
                                        <span class="file-size">${size}</span>
                                    </div>
                                    <button class="file-download-btn" onclick="downloadFile('${fileData}', '${file.name}')">⬇ Скачать</button>
                                </div>
                            `;
                            sendOutgoingMessage(true, fileHtml, `📄 ${file.name}`);
                        }
                    };
                    reader.readAsDataURL(file);
                });
                this.value = '';
            }
        });

        // Авто-расширение
        document.getElementById('messageInputField').addEventListener('input', function() {
            this.style.height = 'auto';
            this.style.height = Math.min(this.scrollHeight, 100) + 'px';
            if (this.value.trim().length > 0 && currentChatId) {
                showTyping();
            }
        });

        // ===== НАСТРОЙКИ =====
        document.getElementById('editProfileBtn').addEventListener('click', () => {
            document.getElementById('editNameInput').value = profileData.name;
            document.getElementById('editUsernameInput').value = profileData.username;
            document.getElementById('editStatusInput').value = profileData.status;
            if (profileData.avatar) {
                document.getElementById('editAvatarPreview').style.backgroundImage = `url(${profileData.avatar})`;
                document.getElementById('editAvatarPreview').style.backgroundSize = 'cover';
                document.getElementById('editAvatarPreview').style.backgroundPosition = 'center';
                document.getElementById('editAvatarPreview').textContent = '';
            }
            document.getElementById('profileEditModal').classList.add('show');
        });

        document.getElementById('changeStatusBtn').addEventListener('click', () => {
            document.getElementById('statusModal').classList.add('show');
            document.querySelectorAll('#statusModal .modal-option').forEach(opt => {
                opt.classList.remove('active');
                if (opt.textContent.trim().includes(profileData.status)) {
                    opt.classList.add('active');
                }
            });
        });

        document.getElementById('themeSelector').addEventListener('click', () => {
            document.getElementById('themeModal').classList.add('show');
            document.querySelectorAll('#themeModal .modal-option').forEach(opt => {
                opt.classList.remove('active');
                if (opt.dataset.theme === currentTheme) opt.classList.add('active');
            });
        });

        document.getElementById('clearHistoryBtn').addEventListener('click', () => {
            document.getElementById('confirmModal').classList.add('show');
        });

        document.getElementById('aboutBtn').addEventListener('click', () => {
            alert('📱 Blist v2.0.1\n\nРазработчик: Команда Blist\nГод: 2026\n\nСделано с ❤️');
        });

        // Toggle переключатели
        document.querySelectorAll('.toggle').forEach(toggle => {
            toggle.addEventListener('click', function() {
                this.classList.toggle('active');
                localStorage.setItem(`blist_${this.id}`, this.classList.contains('active') ? 'on' : 'off');
            });
            const saved = localStorage.getItem(`blist_${toggle.id}`);
            if (saved === 'off') toggle.classList.remove('active');
        });

        // Размер шрифта
        document.getElementById('fontSizeSlider').addEventListener('input', function() {
            const size = this.value + 'px';
            document.querySelector('.chat-messages-area').style.fontSize = size;
            document.querySelectorAll('.message-bubble').forEach(el => el.style.fontSize = size);
            localStorage.setItem('blist_font_size', this.value);
        });
        const savedFontSize = localStorage.getItem('blist_font_size');
        if (savedFontSize) {
            document.getElementById('fontSizeSlider').value = savedFontSize;
            document.getElementById('fontSizeSlider').dispatchEvent(new Event('input'));
        }

        // Закрытие модалок по клику вне
        document.querySelectorAll('.modal-overlay').forEach(modal => {
            modal.addEventListener('click', (e) => {
                if (e.target === modal) modal.classList.remove('show');
            });
        });
    </script>
</body>
</html>
